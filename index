    async function fetchImageFromWebLink(silent = false) {
      const link = document.getElementById('wish-link').value.trim();
      const statusEl = document.getElementById('img-fetch-status');
      const btn = document.getElementById('btn-fetch-link-img');

      if (!link || !link.startsWith('http')) {
        if (!silent) showToast('Bạn hãy dán đường link web sản phẩm (https://...) trước nhé!', 'error');
        return;
      }

      const mercariMatch = link.match(/mercari\.com\/(?:en\/)?item\/(m\d+)/i);
      if (mercariMatch) {
        const itemId = mercariMatch[1];
        const merImg = `https://static.mercdn.net/item/detail/orig/photos/${itemId}_1.jpg`;
        document.getElementById('wish-image').value = merImg;
        previewWishImageFromInput();
        statusEl.textContent = '✅ Đã lấy ảnh từ Mercari!';
        if (!silent) showToast('✨ Đã tự động lấy ảnh sản phẩm Mercari!');
        return;
      }

      if (btn) btn.disabled = true;
      statusEl.textContent = '⏳ Đang quét ảnh từ trang web...';

      try {
        const res = await fetch(`https://api.microlink.io/?url=${encodeURIComponent(link)}`);
        const json = await res.json();
        const imgUrl = json?.data?.image?.url || json?.data?.logo?.url;
        const pageTitle = json?.data?.title;

        if (imgUrl) {
          document.getElementById('wish-image').value = imgUrl;
          previewWishImageFromInput();
          statusEl.textContent = '✅ Đã lấy được ảnh!';
          const nameInput = document.getElementById('wish-name');
          if (pageTitle && !nameInput.value.trim()) {
            nameInput.value = pageTitle.slice(0, 70);
          }
          if (!silent) showToast('✨ Đã lấy ảnh từ link web thành công!');
        } else {
          statusEl.textContent = '⚠️ Link này chặn lấy ảnh tự động';
          if (!silent) showToast('Trang này chặn quét ảnh tự động (VD: Facebook/Shopee). Bạn có thể chụp màn hình rồi nhấn Ctrl+V để dán ảnh nhé!', 'error');
        }
      } catch (err) {
        statusEl.textContent = '⚠️ Không thể tự lấy ảnh';
        if (!silent) showToast('Không thể lấy ảnh từ link này, hãy thử tải ảnh lên hoặc nhấn Ctrl+V!', 'error');
