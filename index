    function updateOrderStatus(id, newStatus) {
      const ord = appData.orders.find(o => o.id === id);
      if (!ord) return;
      ord.status = newStatus;
      persistAndSync();
      showToast(`Đã cập nhật trạng thái: ${getOrderStatusLabel(newStatus)}`);
    }

    function openOrderModal(id = null, triggerFilePick = false) {
      const form = document.getElementById('form-order');
      if (form) form.reset();
      syncCategorySelects();
      document.getElementById('order-id').value = id || '';
      document.getElementById('order-img-fetch-status').textContent = '';

      if (id) {
        const o = appData.orders.find(x => x.id === id);
        if (o) {
          document.getElementById('modal-order-title').textContent = '✏️ Chỉnh sửa đơn hàng';
          document.getElementById('order-name').value = o.name || '';
          document.getElementById('order-category').value = o.category || customCategories[0] || 'Goods Idol';
          const cur = o.currency || 'VND';
          document.getElementById('order-currency').value = cur;
          document.getElementById('order-price').value = cur !== 'VND' && Number(o.origPrice) > 0 ? o.origPrice : (o.price || '');
          document.getElementById('order-image').value = o.image || '';
          document.getElementById('order-stars').value = o.stars || 5;
          document.getElementById('order-carrier').value = o.carrier || '';
          document.getElementById('order-tracking').value = o.tracking || '';
          document.getElementById('order-link').value = o.link || '';
          document.getElementById('order-status').value = o.status || 'Chưa về ⏳';
          document.getElementById('order-note').value = o.note || '';
        }
      } else {
        document.getElementById('modal-order-title').textContent = '📦 Thêm đơn hàng mới';
        document.getElementById('order-currency').value = 'VND';
        document.getElementById('order-status').value = 'Chưa về ⏳';
      }
      updateCurrencyPreview('order');
      previewOrderImageFromInput();
      openModal('modal-order');
      if (triggerFilePick) {
        setTimeout(() => document.getElementById('order-image-file')?.click(), 80);
      } else {
        setTimeout(() => document.getElementById('order-name')?.focus(), 50);
      }
    }

    function previewOrderImageFromInput() {
      const url = (document.getElementById('order-image')?.value || '').trim();
      const img = document.getElementById('order-img-preview');
      const placeholder = document.getElementById('order-img-placeholder');
      const clearBtn = document.getElementById('btn-clear-order-img');
      if (!img || !placeholder || !clearBtn) return;

      if (url) {
        img.src = url;
        img.classList.remove('hidden');
        placeholder.classList.add('hidden');
        clearBtn.classList.remove('hidden');
        clearBtn.classList.add('flex');
      } else {
        img.src = '';
        img.classList.add('hidden');
        placeholder.classList.remove('hidden');
        clearBtn.classList.add('hidden');
        clearBtn.classList.remove('flex');
      }
    }

    function clearOrderImage() {
      document.getElementById('order-image').value = '';
      document.getElementById('order-img-fetch-status').textContent = '';
      previewOrderImageFromInput();
    }

    function autoFetchOrderImageIfEmpty() {
      if (!document.getElementById('order-image').value.trim()) {
        fetchOrderImageFromWebLink(true);
      }
    }

    async function fetchOrderImageFromWebLink(silent = false) {
      const link = document.getElementById('order-link').value.trim();
      const statusEl = document.getElementById('order-img-fetch-status');
      const btn = document.getElementById('btn-fetch-order-link-img');

      if (!link || !link.startsWith('http')) {
        if (!silent) showToast('Bạn hãy dán link sản phẩm (https://...) trước nhé!', 'error');
        return;
      }

      const mercariMatch = link.match(/mercari\.com\/(?:en\/)?item\/(m\d+)/i);
      if (mercariMatch) {
        const itemId = mercariMatch[1];
        document.getElementById('order-image').value = `https://static.mercdn.net/item/detail/orig/photos/${itemId}_1.jpg`;
        previewOrderImageFromInput();
        statusEl.textContent = '✅ Đã lấy ảnh Mercari!';
        if (!silent) showToast('✨ Đã tự động lấy ảnh sản phẩm Mercari!');
        return;
      }

      if (btn) btn.disabled = true;
      statusEl.textContent = '⏳ Đang quét ảnh...';
      try {
        const res = await fetch(`https://api.microlink.io/?url=${encodeURIComponent(link)}`);
        const json = await res.json();
        const imgUrl = json?.data?.image?.url || json?.data?.logo?.url;
        if (imgUrl) {
          document.getElementById('order-image').value = imgUrl;
          previewOrderImageFromInput();
          statusEl.textContent = '✅ Đã lấy ảnh!';
        } else {
          statusEl.textContent = '⚠️ Trang này chặn tự lấy ảnh';
        }
      } catch (e) {
        statusEl.textContent = '⚠️ Không thể tự lấy ảnh';
      } finally {
        if (btn) btn.disabled = false;
      }
    }

    function handleOrderFileUpload(event) {
      const file = event.target.files?.[0];
      if (!file) return;
      compressImageFile(file, 720, 0.85, (dataUrl) => {
        document.getElementById('order-image').value = dataUrl;
        previewOrderImageFromInput();
        document.getElementById('order-img-fetch-status').textContent = '⏳ Đang quét ảnh...';
        scanOrderImageWithAI(true);
      });
    }

    async function scanOrderImageWithAI(isAuto = false) {
      const imgSrc = document.getElementById('order-image').value.trim();
      const statusEl = document.getElementById('order-img-fetch-status');
      const btn = document.getElementById('btn-ai-scan-order');

      if (!imgSrc) {
        if (!isAuto) showToast('Bạn hãy tải ảnh bill / sản phẩm lên hoặc dán Ctrl+V trước nhé!', 'error');
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.classList.add('opacity-60');
      }
      statusEl.textContent = '📸 AI đang đọc bill / mã vận đơn...';

      try {
        const inlineImg = await imageSrcToBase64(imgSrc);
        const apiKey = "";
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

        const promptText = `Hãy phân tích hình ảnh này (ảnh đơn hàng, bill chuyển khoản, hoặc ảnh sản phẩm).
Trả về JSON chuẩn:
- name: Tên món đồ ngắn gọn bằng tiếng Việt.
- price: Giá tiền gốc trên ảnh (chỉ trả số).
- currency: Mã tiền tệ ("VND", "JPY", "KRW", "CNY", "USD", "THB").
- category: Chọn 1 danh mục phù hợp trong ${JSON.stringify(customCategories)}.
- carrier: Đơn vị vận chuyển nếu có (SPX, GHTK, GHN, J&T, Viettel Post...), không có thì "".
- tracking: Mã vận đơn nếu có (VD: SPXVN...), không có thì "".
- note: Ghi chú hữu ích rút ra từ ảnh.`;

        const payload = {
          contents: [{
            role: 'user',
            parts: [
              { text: promptText },
              { inlineData: { mimeType: inlineImg.mimeType, data: inlineImg.data } }
            ]
          }],
          generationConfig: {
            responseMimeType: "application/json",
            responseSchema: {
              type: "OBJECT",
              properties: {
                name: { type: "STRING" },
                price: { type: "NUMBER" },
                currency: { type: "STRING" },
                category: { type: "STRING" },
                carrier: { type: "STRING" },
                tracking: { type: "STRING" },
                note: { type: "STRING" }
              },
              required: ["name", "price", "currency", "category", "carrier", "tracking", "note"]
            }
          }
        };

        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const result = await response.json();
        const rawText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!rawText) throw new Error('Empty');
        const info = JSON.parse(rawText);

        if (info.name) document.getElementById('order-name').value = info.name;
        const detectedCur = ['VND', 'JPY', 'KRW', 'CNY', 'USD', 'THB'].includes(info.currency) ? info.currency : 'VND';
        document.getElementById('order-currency').value = detectedCur;
        if (info.price && Number(info.price) > 0) {
          document.getElementById('order-price').value = detectedCur === 'VND' ? Math.round(Number(info.price)) : Number(info.price);
        }
        updateCurrencyPreview('order');
        if (info.category && customCategories.includes(info.category)) {
          document.getElementById('order-category').value = info.category;
        }
        if (info.carrier) document.getElementById('order-carrier').value = info.carrier;
        if (info.tracking) document.getElementById('order-tracking').value = info.tracking.toUpperCase();
        if (info.note) {
          const prev = document.getElementById('order-note').value.trim();
          document.getElementById('order-note').value = prev ? `${prev} | ${info.note}` : info.note;
        }
        statusEl.textContent = '✅ AI đã trích xuất thông tin!';
        showToast('📸 AI đã đọc xong thông tin đơn hàng!');
      } catch (err) {
        statusEl.textContent = '⚠️ Không đọc được chữ từ ảnh này';
        if (!isAuto) showToast('Không thể đọc ảnh này!', 'error');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.classList.remove('opacity-60');
        }
      }
    }

    function saveOrder(e) {
      if (e) e.preventDefault();
      const id = document.getElementById('order-id').value;
      const existing = id ? appData.orders.find(x => x.id === id) : null;
      const rawName = document.getElementById('order-name').value.trim();
      const rawTracking = document.getElementById('order-tracking').value.trim().toUpperCase();
      const rawCarrier = document.getElementById('order-carrier').value.trim();
      const rawLink = document.getElementById('order-link').value.trim();
      const currency = document.getElementById('order-currency').value || 'VND';
      const origPrice = Number(document.getElementById('order-price').value) || 0;
      const vndPrice = convertToVND(origPrice, currency);

      const payload = {
        id: id || 'ord_' + Date.now(),
        name: rawName || (rawTracking ? `Đơn ${rawTracking}` : 'Đơn hàng mới'),
        category: document.getElementById('order-category').value || customCategories[0] || 'Goods Idol',
        currency: currency,
        origPrice: currency !== 'VND' ? origPrice : 0,
        price: vndPrice,
        image: document.getElementById('order-image').value.trim(),
        stars: Number(document.getElementById('order-stars').value) || 5,
        carrier: rawCarrier || (rawTracking.startsWith('SPX') ? 'SPX' : ''),
        tracking: rawTracking,
        link: rawLink,
        status: document.getElementById('order-status').value || 'Chưa về ⏳',
        note: document.getElementById('order-note').value.trim(),
        starred: existing ? !!existing.starred : false
      };

      const oldTracking = (existing?.tracking || '').toUpperCase();

      // Nếu đang sửa đơn có mã vận đơn và người dùng xóa trống mã vận đơn -> chuyển về tab Danh sách đồ đã chốt đơn
      if (id && oldTracking && !rawTracking) {
        appData.orders = appData.orders.filter(x => x.id !== id);
        const linkedWish = appData.wishlist.find(w => (w.tracking || '').toUpperCase() === oldTracking || w.name === payload.name);
        if (linkedWish) {
          linkedWish.tracking = '';
          linkedWish.carrier = '';
          linkedWish.status = 'Đang cân nhắc';
        } else {
          appData.wishlist.unshift({
            id: 'w_' + Date.now(),
            name: payload.name,
            category: payload.category,
            currency: payload.currency,
            origPrice: payload.origPrice,
            price: payload.price,
            status: 'Đang cân nhắc',
            link: payload.link,
            image: payload.image,
            stars: payload.stars,
            note: payload.note,
            carrier: '',
            tracking: '',
            starred: payload.starred
          });
        }
        closeModal('modal-order');
        setWishFilter('ALL');
        persistAndSync();
        switchTab('wishlist');
        showToast('↩️ Đã xóa mã vận đơn và chuyển về Danh sách đồ đã chốt đơn!');
        return;
      }

      if (id) {
        const idx = appData.orders.findIndex(x => x.id === id);
        if (idx !== -1) appData.orders[idx] = payload;
      } else {
        appData.orders.unshift(payload);
      }

      // Đồng bộ 2 chiều nếu có món khớp bên Danh sách đồ đã chốt đơn
      if (rawTracking || oldTracking) {
        const matchWish = appData.wishlist.find(w =>
          (oldTracking && (w.tracking || '').toUpperCase() === oldTracking) ||
          (rawTracking && (w.tracking || '').toUpperCase() === rawTracking)
        );
        if (matchWish) {
          matchWish.name = payload.name;
          matchWish.category = payload.category;
          matchWish.currency = payload.currency;
          matchWish.origPrice = payload.origPrice;
          if (payload.price > 0) matchWish.price = payload.price;
          if (payload.image) matchWish.image = payload.image;
          matchWish.stars = payload.stars;
          matchWish.carrier = payload.carrier;
          matchWish.tracking = rawTracking;
          if (payload.link) matchWish.link = payload.link;
          if (payload.note) matchWish.note = payload.note;
        }
      }

      if (orderFilter !== 'ALL' && orderFilter !== payload.status) {
        setOrderFilter('ALL');
      }

      closeModal('modal-order');
      persistAndSync();
      showToast('Đã lưu đơn hàng! 📦');
    }

    function deleteOrder(id) {
      appData.orders = appData.orders.filter(o => o.id !== id);
      persistAndSync();
      showToast('Đã xóa đơn hàng!');
    }

    // ==================== TAB 2: WISHLIST (DANH SÁCH ĐỒ ĐÃ CHỐT ĐƠN) ====================
    function setWishFilter(filter) {
      wishFilter = filter;
      document.querySelectorAll('.wish-filter-btn').forEach(btn => {
        if (btn.dataset.wfilter === filter) {
          btn.classList.add('bg-brand-primary', 'text-white', 'font-bold');
          btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-brand-border', 'font-semibold');
        } else {
          btn.classList.remove('bg-brand-primary', 'text-white', 'font-bold');
          btn.classList.add('bg-white', 'text-slate-600', 'border', 'border-brand-border', 'font-semibold');
        }
      });
      renderWishlist();
    }

    function renderWishlist() {
      const q = (document.getElementById('wish-search')?.value || '').trim().toLowerCase();
      const catFilter = document.getElementById('wish-cat-filter')?.value || 'ALL';

      const totalSpent = appData.wishlist
        .filter(w => w.status === 'Đã mua' || w.status === 'Đang về')
        .reduce((acc, w) => acc + (Number(w.price) || 0), 0);

      document.getElementById('stat-wish-spent').textContent = formatVND(totalSpent);
      const wishStatsBarEl = document.getElementById('wish-stats-bar');
      const remainingCardEl = document.getElementById('stat-wish-remaining-card');
      const remainingValEl = document.getElementById('stat-wish-remaining');
      const remainingSubEl = document.getElementById('stat-wish-remaining-sub');
      const remainingIconEl = document.getElementById('stat-wish-remaining-icon');
      const budgetSubEl = document.getElementById('stat-wish-budget-sub');
      const budgetWrapEl = document.getElementById('budget-progress-wrap');
      const budgetBarEl = document.getElementById('budget-progress-bar');

      if (userPrefs.budgetLimit > 0 && budgetSubEl && budgetWrapEl && budgetBarEl) {
        const pct = Math.min(100, Math.round((totalSpent / userPrefs.budgetLimit) * 100));
        const remaining = userPrefs.budgetLimit - totalSpent;

        if (wishStatsBarEl) {
          wishStatsBarEl.className = 'grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-4 items-stretch';
        }
        if (remainingCardEl && remainingValEl && remainingSubEl && remainingIconEl) {
          remainingCardEl.classList.remove('hidden');
          remainingCardEl.classList.add('flex');
          if (remaining < 0) {
            remainingCardEl.classList.remove('border-l-emerald-500');
            remainingCardEl.classList.add('border-l-rose-500');
            remainingValEl.textContent = '-' + formatVND(Math.abs(remaining));
            remainingValEl.className = 'text-lg sm:text-2xl font-bold text-rose-600 mt-0.5 sm:mt-1 truncate';
            remainingSubEl.textContent = `Vượt hạn mức ${formatVND(userPrefs.budgetLimit)}`;
            remainingIconEl.className = 'w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-rose-50 flex items-center justify-center text-lg sm:text-2xl shrink-0';
            remainingIconEl.textContent = '🚨';
          } else {
            remainingCardEl.classList.remove('border-l-rose-500');
            remainingCardEl.classList.add('border-l-emerald-500');
            remainingValEl.textContent = formatVND(remaining);
            remainingValEl.className = 'text-lg sm:text-2xl font-bold text-emerald-600 mt-0.5 sm:mt-1 truncate';
            remainingSubEl.textContent = `Tổng ngân sách: ${formatVND(userPrefs.budgetLimit)}`;
            remainingIconEl.className = 'w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-emerald-50 flex items-center justify-center text-lg sm:text-2xl shrink-0';
            remainingIconEl.textContent = '💰';
          }
        }

        budgetWrapEl.classList.remove('hidden');
        budgetBarEl.style.width = pct + '%';
        if (totalSpent > userPrefs.budgetLimit) {
          budgetBarEl.className = 'bg-rose-500 h-1.5 rounded-full transition-all duration-300';
          budgetSubEl.textContent = `⚠️ Đã dùng ${pct}% ngân sách`;
          budgetSubEl.className = 'text-[11px] font-bold text-rose-600 mt-0.5 truncate';
        } else {
          budgetBarEl.className = 'bg-brand-accent h-1.5 rounded-full transition-all duration-300';
          budgetSubEl.textContent = `Đã dùng ${pct}% ngân sách`;
          budgetSubEl.className = 'text-[11px] font-semibold text-slate-500 mt-0.5 truncate';
        }
      } else if (budgetSubEl && budgetWrapEl) {
        if (wishStatsBarEl) {
          wishStatsBarEl.className = 'grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-4 items-stretch';
        }
        if (remainingCardEl) {
          remainingCardEl.classList.add('hidden');
          remainingCardEl.classList.remove('flex');
        }
        budgetWrapEl.classList.add('hidden');
        budgetSubEl.textContent = 'Đã mua + Đang về';
        budgetSubEl.className = 'text-[11px] text-slate-400 mt-0.5 truncate';
      }

      document.getElementById('stat-wish-count').textContent = appData.wishlist.length;
      document.getElementById('tab-count-wishlist').textContent = appData.wishlist.length;
      const mobCountWish = document.getElementById('mobile-count-wishlist');
      if (mobCountWish) mobCountWish.textContent = appData.wishlist.length;

      const filtered = sortWithStarredFirst(appData.wishlist).filter(w => {
        if (wishFilter !== 'ALL' && w.status !== wishFilter) return false;
        if (catFilter !== 'ALL' && w.category !== catFilter) return false;
        if (q) {
          const hay = `${w.name} ${w.category} ${w.note} ${w.link} ${w.tracking || ''}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });

      const gridEl = document.getElementById('wish-cards-grid');
      const listWrap = document.getElementById('wish-list-wrap');
      const listBody = document.getElementById('wish-list-body');
      const emptyEl = document.getElementById('wish-empty');

      if (filtered.length === 0) {
        gridEl.classList.add('hidden');
        listWrap.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        return;
      }
      emptyEl.classList.add('hidden');

      if (currentViewMode === 'grid') {
        gridEl.classList.remove('hidden');
        listWrap.classList.add('hidden');
        gridEl.innerHTML = filtered.map(w => buildWishCardHtml(w)).join('');
      } else {
        gridEl.classList.add('hidden');
        listWrap.classList.remove('hidden');
        listBody.innerHTML = filtered.map(w => buildWishRowHtml(w)).join('');
      }
    }

