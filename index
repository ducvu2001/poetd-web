    function toggleAutoSync() {
      sheetConfig.autoSync = document.getElementById('sheet-autosync-toggle').checked;
      localStorage.setItem(SHEET_CONFIG_KEY, JSON.stringify(sheetConfig));
    }

    function updateSheetButtonsUI() {
      const quickBtn = document.getElementById('btn-quick-sync');
      const quickMobBtn = document.getElementById('btn-quick-sync-mobile');
      if (sheetConfig.url) {
        if (quickBtn) {
          quickBtn.classList.remove('hidden');
          quickBtn.classList.add('inline-flex');
        }
        if (quickMobBtn) {
          quickMobBtn.classList.remove('hidden');
          quickMobBtn.classList.add('inline-flex');
        }
        updateSyncBadge('connected');
      } else {
        if (quickBtn) {
          quickBtn.classList.add('hidden');
          quickBtn.classList.remove('inline-flex');
        }
        if (quickMobBtn) {
          quickMobBtn.classList.add('hidden');
          quickMobBtn.classList.remove('inline-flex');
