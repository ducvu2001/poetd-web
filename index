          '--ai-header-bg': c.headerBg,
          '--ai-header-text': c.headerText,
          '--ai-header-sub': c.headerSub
        };

        localStorage.setItem(AI_THEME_STORAGE_KEY, JSON.stringify({ name: c.themeName, vars }));
        applyAiThemeVariables(c.themeName, vars);
        setTheme('ai-custom');
        if (statusEl) statusEl.textContent = `✅ Đã áp dụng "${c.themeName}"!`;
        showToast(`🎨 AI đã tạo & áp dụng chủ đề "${c.themeName}"!`);
