    function openBookModal(id = null) {
      const form = document.getElementById('form-book');
      if (form) form.reset();
      document.getElementById('book-id').value = id || '';
      const aiStatus = document.getElementById('ai-book-status');
      if (aiStatus) {
        aiStatus.textContent = '';
        aiStatus.classList.add('hidden');
      }

      if (id) {
        const b = appData.books.find(x => x.id === id);
        if (b) {
          document.getElementById('modal-book-title').textContent = '✏️ Chỉnh sửa sách';
          document.getElementById('book-title').value = b.title || '';
          document.getElementById('book-author').value = b.author || '';
          document.getElementById('book-genre').value = b.genre || '';
          document.getElementById('book-status').value = b.status || 'Dự định đọc';
          document.getElementById('book-stars').value = b.stars || 5;
          document.getElementById('book-date').value = b.date || '';
          document.getElementById('book-review').value = b.review || '';
        }
      } else {
        document.getElementById('modal-book-title').textContent = '📚 Thêm sách mới';
        document.getElementById('book-status').value = 'Dự định đọc';
      }
      openModal('modal-book');
      setTimeout(() => document.getElementById('book-title')?.focus(), 50);
    }

    function saveBook(e) {
      if (e) e.preventDefault();
      const id = document.getElementById('book-id').value;
      const title = document.getElementById('book-title').value.trim();
      if (!title) {
        showToast('Bạn hãy nhập tên sách nhé!', 'error');
        return;
      }
      const existing = id ? appData.books.find(x => x.id === id) : null;

      const payload = {
        id: id || 'b_' + Date.now(),
        title,
        author: document.getElementById('book-author').value.trim(),
        genre: document.getElementById('book-genre').value.trim(),
        status: document.getElementById('book-status').value || 'Dự định đọc',
        stars: Number(document.getElementById('book-stars').value) || 5,
        date: document.getElementById('book-date').value.trim(),
        review: document.getElementById('book-review').value.trim(),
        starred: existing ? !!existing.starred : false
      };

      if (id) {
        const idx = appData.books.findIndex(x => x.id === id);
        if (idx !== -1) appData.books[idx] = payload;
      } else {
        appData.books.unshift(payload);
      }

      if (bookFilter !== 'ALL' && bookFilter !== payload.status) {
        setBookFilter('ALL');
      }

      closeModal('modal-book');
      persistAndSync();
      showToast('Đã lưu sách vào kệ! 📚');
    }

    function deleteBook(id) {
      appData.books = appData.books.filter(x => x.id !== id);
      persistAndSync();
      showToast('Đã xóa sách khỏi kệ!');
    }

    function applyBookSort(mode) {
      if (mode === 'stars-desc') {
        appData.books.sort((a, b) => (Number(b.stars) || 0) - (Number(a.stars) || 0));
      } else if (mode === 'title-asc') {
        appData.books.sort((a, b) => (a.title || '').localeCompare(b.title || '', 'vi'));
      } else if (mode === 'date-desc') {
        appData.books.sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')));
      }
      persistAndSync();
    }

    async function autoFillBookWithAI() {
      const title = document.getElementById('book-title').value.trim();
      const statusEl = document.getElementById('ai-book-status');
      const btn = document.getElementById('btn-ai-book');
      if (!title) {
        showToast('Bạn hãy gõ tên sách trước rồi bấm AI Tự điền nhé!', 'error');
        return;
      }

      btn.disabled = true;
      btn.classList.add('opacity-60');
      statusEl.classList.remove('hidden');
      statusEl.textContent = '✨ AI đang tìm tác giả và tóm tắt đánh giá cuốn sách...';

      const apiKey = "";
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const prompt = `Với cuốn sách có tên "${title}", hãy cung cấp thông tin ngắn gọn bằng tiếng Việt dưới dạng JSON gồm:
- author: Tên tác giả chính xác nhất
- genre: Thể loại ngắn gọn (ví dụ: Văn học kinh điển, Trinh thám, Đam mỹ, Thần thoại, Tâm lý chữa lành...)
- stars: Số sao đánh giá phổ biến từ 1 đến 5
- review: Nhận xét/đánh giá chung súc tích, cảm xúc trong 1-2 câu (khoảng 15-30 từ).`;

      const payload = {
        contents: [{ parts: [{ text: prompt }] }],
        generationConfig: {
          responseMimeType: "application/json",
          responseSchema: {
            type: "OBJECT",
            properties: {
              author: { type: "STRING" },
              genre: { type: "STRING" },
              stars: { type: "INTEGER" },
              review: { type: "STRING" }
            },
            required: ["author", "genre", "stars", "review"]
          }
        }
      };

      try {
        let result = null;
        for (let attempt = 0; attempt < 3; attempt++) {
          try {
            const response = await fetch(apiUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            if (!response.ok) throw new Error('HTTP ' + response.status);
            result = await response.json();
            break;
          } catch (err) {
            if (attempt === 2) throw err;
            await new Promise(r => setTimeout(r, 1000 * Math.pow(2, attempt)));
          }
        }

        const rawText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!rawText) throw new Error('Empty response');
        const info = JSON.parse(rawText);

        if (info.author) document.getElementById('book-author').value = info.author;
        if (info.genre) document.getElementById('book-genre').value = info.genre;
        if (info.stars) document.getElementById('book-stars').value = Math.min(5, Math.max(1, Number(info.stars)));
        if (info.review) document.getElementById('book-review').value = info.review;

        statusEl.textContent = '✅ Đã tự điền thông tin sách!';
        showToast('✨ AI đã điền xong thông tin cuốn sách!');
      } catch (err) {
        statusEl.textContent = '⚠️ Không kết nối được AI lúc này, bạn có thể nhập tay nhé.';
        showToast('Không thể gọi AI tự điền lúc này!', 'error');
      } finally {
        btn.disabled = false;
        btn.classList.remove('opacity-60');
      }
    }

