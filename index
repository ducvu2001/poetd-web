  <script>
    // ==================== USER PREFERENCES (TRUNG TÂM TÙY CHỈNH) ====================
    const PREFS_KEY = 'pastel_tracker_user_prefs_v1';
    const DEFAULT_USER_PREFS = {
      appTitle: 'Trang web ngớ ngẩn của POETD_ 🐍',
      defaultTab: 'orders',
      gridCols: 'compact',
      cardRadius: 'soft',
      showStats: true,
      showNotes: true,
      budgetLimit: 0,
      jpyRate: 170,
      krwRate: 18.5,
      cnyRate: 3550,
      usdRate: 25400,
      thbRate: 740,
      labels: {
        ordPending: 'Chưa về ⏳',
        ordShipping: 'Đang giao 🚚',
        ordReceived: 'Đã nhận 💖',
        wishPending: 'Đang cân nhắc',
        wishShipping: 'Đang về',
        wishBought: 'Đã mua'
      }
    };

    const CURRENCY_SYMBOLS = {
      VND: '₫',
      JPY: '¥',
      KRW: '₩',
      CNY: '¥ CNY',
      USD: '$',
      THB: '฿'
    };

    function getCurrencyRate(currency) {
      const c = (currency || 'VND').toUpperCase();
      if (c === 'JPY') return Number(userPrefs.jpyRate) || 170;
      if (c === 'KRW') return Number(userPrefs.krwRate) || 18.5;
      if (c === 'CNY') return Number(userPrefs.cnyRate) || 3550;
      if (c === 'USD') return Number(userPrefs.usdRate) || 25400;
      if (c === 'THB') return Number(userPrefs.thbRate) || 740;
      return 1;
    }

    function convertToVND(rawAmount, currency) {
      const amt = Number(rawAmount) || 0;
      if (amt <= 0) return 0;
      const c = (currency || 'VND').toUpperCase();
      if (c === 'VND') return Math.round(amt);
      return Math.round(amt * getCurrencyRate(c));
    }

    function formatOriginalPrice(rawAmount, currency) {
      const amt = Number(rawAmount) || 0;
      const c = (currency || 'VND').toUpperCase();
      if (amt <= 0 || c === 'VND') return '';
      const sym = CURRENCY_SYMBOLS[c] || c;
      return `${amt.toLocaleString('vi-VN')} ${sym}`;
    }

    function updateCurrencyPreview(prefix) {
      const cur = document.getElementById(`${prefix}-currency`)?.value || 'VND';
      const raw = Number(document.getElementById(`${prefix}-price`)?.value) || 0;
      const previewEl = document.getElementById(`${prefix}-vnd-preview`);
      if (!previewEl) return;
      if (cur === 'VND' || raw <= 0) {
        previewEl.textContent = '';
      } else {
        const vnd = convertToVND(raw, cur);
        previewEl.textContent = `≈ ${formatVND(vnd)}`;
      }
    }

    let userPrefs = JSON.parse(JSON.stringify(DEFAULT_USER_PREFS));

    function loadUserPrefs() {
      try {
        const raw = localStorage.getItem(PREFS_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          userPrefs = {
            ...DEFAULT_USER_PREFS,
            ...parsed,
            labels: { ...DEFAULT_USER_PREFS.labels, ...(parsed.labels || {}) }
          };
