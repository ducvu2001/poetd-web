    function openWishModal(id = null, triggerFilePick = false) {
      const form = document.getElementById('form-wish');
      if (form) form.reset();
      syncCategorySelects();
      document.getElementById('wish-id').value = id || '';
      document.getElementById('img-fetch-status').textContent = '';

      if (id) {
