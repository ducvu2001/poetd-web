    function setViewMode(mode) {
      currentViewMode = mode === 'list' ? 'list' : 'grid';
      localStorage.setItem(VIEW_MODE_KEY, currentViewMode);
      ['grid', 'list'].forEach(m => {
        const btn = document.getElementById(`view-mode-${m}`);
        if (!btn) return;
        if (m === currentViewMode) {
          btn.classList.add('bg-white', 'text-brand-primaryText', 'shadow-2xs');
          btn.classList.remove('text-slate-600');
        } else {
          btn.classList.remove('bg-white', 'text-brand-primaryText', 'shadow-2xs');
          btn.classList.add('text-slate-600');
        }
      });
      renderAll();
    }

    // ==================== STAR PINNING & DRAG-DROP REORDER ====================
    function sortWithStarredFirst(arr) {
      const starred = [];
      const normal = [];
      arr.forEach(item => (item.starred ? starred : normal).push(item));
      return [...starred, ...normal];
    }

    function toggleStarItem(listKey, id) {
      const list = appData[listKey];
      if (!list) return;
      const item = list.find(x => x.id === id);
      if (!item) return;
      item.starred = !item.starred;
      persistAndSync();
      showToast(item.starred ? '⭐ Đã ghim lên đầu danh sách!' : 'Đã bỏ ghim!');
    }

    function handleDragStart(e, listKey, id) {
      dragState = { listKey, id };
      if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
      if (e.currentTarget) e.currentTarget.classList.add('opacity-50');
    }

    function handleDragOver(e) {
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
    }

    function handleDrop(e, listKey, targetId) {
      e.preventDefault();
      if (!dragState.id || dragState.listKey !== listKey || dragState.id === targetId) return;
      const list = appData[listKey];
      const fromIdx = list.findIndex(x => x.id === dragState.id);
      const toIdx = list.findIndex(x => x.id === targetId);
      if (fromIdx === -1 || toIdx === -1) return;
      const [moved] = list.splice(fromIdx, 1);
      list.splice(toIdx, 0, moved);
      dragState = { listKey: null, id: null };
      persistAndSync();
    }

    function handleDragEnd(e) {
      if (e.currentTarget) e.currentTarget.classList.remove('opacity-50');
      dragState = { listKey: null, id: null };
    }

    // ==================== TAB 1: ORDERS (ĐƠN HÀNG ĐANG VỀ) ====================
    function setOrderFilter(filter) {
      orderFilter = filter;
      document.querySelectorAll('.order-filter-btn').forEach(btn => {
        if (btn.dataset.filter === filter) {
          btn.classList.add('bg-brand-primary', 'text-white', 'font-bold');
          btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-brand-border', 'font-semibold');
        } else {
          btn.classList.remove('bg-brand-primary', 'text-white', 'font-bold');
          btn.classList.add('bg-white', 'text-slate-600', 'border', 'border-brand-border', 'font-semibold');
        }
      });
      renderOrders();
    }

    function renderOrders() {
      const q = (document.getElementById('order-search')?.value || '').trim().toLowerCase();
      const total = appData.orders.length;
      const pending = appData.orders.filter(o => o.status === 'Chưa về ⏳').length;
      const shipping = appData.orders.filter(o => o.status === 'Đang giao 🚚').length;
      const received = appData.orders.filter(o => o.status === 'Đã nhận 💖').length;

      document.getElementById('stat-orders-total').textContent = total;
      document.getElementById('stat-orders-pending').textContent = pending;
      document.getElementById('stat-orders-shipping').textContent = shipping;
      document.getElementById('stat-orders-received').textContent = received;
      document.getElementById('tab-count-orders').textContent = total;
      const mobCountOrd = document.getElementById('mobile-count-orders');
      if (mobCountOrd) mobCountOrd.textContent = total;

      const filtered = sortWithStarredFirst(appData.orders).filter(o => {
        if (orderFilter !== 'ALL' && o.status !== orderFilter) return false;
        if (q) {
          const hay = `${o.name} ${o.carrier} ${o.tracking} ${o.note} ${o.link} ${o.category || ''}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });

      const gridEl = document.getElementById('orders-cards-grid');
      const listWrap = document.getElementById('orders-list-wrap');
      const listBody = document.getElementById('orders-list-body');
      const emptyEl = document.getElementById('orders-empty');

      if (filtered.length === 0) {
        gridEl.classList.add('hidden');
        listWrap.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        return;
      }
      emptyEl.classList.add('hidden');

      if (currentViewMode === 'grid') {
        gridEl.classList.remove('hidden');
        listWrap.classList.add('hidden');
        gridEl.innerHTML = filtered.map((o, idx) => buildOrderCardHtml(o, idx + 1)).join('');
      } else {
        gridEl.classList.add('hidden');
        listWrap.classList.remove('hidden');
        listBody.innerHTML = filtered.map((o, idx) => buildOrderRowHtml(o, idx + 1)).join('');
      }
    }

