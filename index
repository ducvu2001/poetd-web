    function renderBookYearlyChart() {
      const chartEl = document.getElementById('book-yearly-chart');
      if (!chartEl) return;

      const yearCounts = {};
      appData.books.forEach(b => {
        const yr = String(b.date || '').trim();
        if (yr && /^\d{4}$/.test(yr)) {
          yearCounts[yr] = (yearCounts[yr] || 0) + 1;
        }
      });

      const years = Object.keys(yearCounts).sort();
      if (years.length === 0) {
        chartEl.innerHTML = `<div class="text-xs text-slate-400 italic my-auto">Chưa có dữ liệu năm hoàn thành</div>`;
        return;
      }

      const maxCount = Math.max(...Object.values(yearCounts), 1);
      chartEl.innerHTML = years.map(yr => {
        const count = yearCounts[yr];
        const heightPct = Math.max(22, Math.round((count / maxCount) * 100));
        const isSelected = bookYearFilter === yr;
        return `
          <button type="button" onclick="setBookYearFilter('${isSelected ? 'ALL' : yr}')" class="flex-1 min-w-[44px] h-full flex flex-col items-center justify-end gap-1 group cursor-pointer" title="Bấm để lọc sách năm ${yr} (${count} cuốn)">
            <span class="text-[11px] font-extrabold ${isSelected ? 'text-brand-accentText' : 'text-slate-700'}">${count}</span>
            <div class="w-full max-w-[34px] rounded-t-lg transition-all ${isSelected ? 'bg-brand-accent ring-2 ring-brand-accent/40' : 'bg-brand-primary/80 group-hover:bg-brand-primary'}" style="height: ${heightPct}%;"></div>
            <span class="text-[10px] font-bold ${isSelected ? 'text-brand-accentText underline' : 'text-slate-500'}">${yr}</span>
          </button>
        `;
      }).join('');
    }

    function renderBooks() {
