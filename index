                <span class="px-2 py-0.5 rounded-md bg-brand-primarySoft text-brand-primaryText text-[11px] font-bold">#${idx + 1}</span>
                <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-[11px] font-semibold">${escapeHtml(rec.genre)}</span>
              </div>
              <h4 class="font-bold text-slate-900 text-base">${escapeHtml(rec.title)}</h4>
              <p class="text-xs text-slate-500">Tác giả: <b class="text-slate-700">${escapeHtml(rec.author)}</b></p>
              <p class="text-xs text-slate-700 bg-amber-50/70 border border-amber-200/60 rounded-xl px-3 py-1.5 mt-1">✨ ${escapeHtml(rec.reason)}</p>
            </div>
            <button type="button" id="btn-add-rec-${idx}" onclick="addRecommendedBook(${idx})" class="px-3.5 py-2.5 rounded-xl bg-brand-primary hover:bg-brand-primaryHover text-white font-bold text-xs whitespace-nowrap transition shrink-0 shadow-2xs">
              + Dự định đọc 📖
            </button>
          </div>
        `).join('');
      } catch (err) {
        tasteBox.innerHTML = '⚠️ Không thể kết nối AI lúc này, bạn thử bấm làm mới lại sau vài giây nhé.';
        listEl.innerHTML = '';
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.classList.remove('opacity-60');
        }
      }
    }

    function addRecommendedBook(idx) {
      const rec = lastRecommendedBooks[idx];
      if (!rec) return;
      appData.books.unshift({
        id: 'b_' + Date.now() + '_' + idx,
        title: rec.title,
        author: rec.author || '',
