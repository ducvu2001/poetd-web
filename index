    // ==================== GOOGLE SHEETS SYNC ====================
    function openSheetModal() {
      document.getElementById('sheet-url-input').value = sheetConfig.url || '';
      document.getElementById('sheet-autosync-toggle').checked = sheetConfig.autoSync !== false;
