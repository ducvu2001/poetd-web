      const total = appData.books.length;
      const reading = appData.books.filter(b => b.status === 'Đang đọc').length;
      const done = appData.books.filter(b => b.status === 'Đã xong').length;
      const plan = appData.books.filter(b => b.status === 'Dự định đọc').length;

      document.getElementById('stat-book-total').textContent = total;
      document.getElementById('stat-book-reading').textContent = reading;
      document.getElementById('stat-book-done').textContent = done;
      document.getElementById('stat-book-plan').textContent = plan;
      document.getElementById('tab-count-books').textContent = total;
      const mobCountBooks = document.getElementById('mobile-count-books');
      if (mobCountBooks) mobCountBooks.textContent = total;

      renderBookYearlyChart();

      const filtered = sortWithStarredFirst(appData.books).filter(b => {
        if (bookFilter !== 'ALL' && b.status !== bookFilter) return false;
        if (bookYearFilter !== 'ALL' && String(b.date || '').trim() !== bookYearFilter) return false;
        if (q) {
          const hay = `${b.title} ${b.author} ${b.genre} ${b.review} ${b.date}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });

      const gridEl = document.getElementById('books-cards-grid');
      const listWrap = document.getElementById('books-list-wrap');
      const listBody = document.getElementById('books-list-body');
      const emptyEl = document.getElementById('books-empty');

      if (filtered.length === 0) {
        gridEl.classList.add('hidden');
        listWrap.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        return;
      }
      emptyEl.classList.add('hidden');

      if (currentViewMode === 'grid') {
        gridEl.classList.remove('hidden');
        listWrap.classList.add('hidden');
        gridEl.innerHTML = filtered.map((b, idx) => buildBookCardHtml(b, idx + 1)).join('');
      } else {
        gridEl.classList.add('hidden');
        listWrap.classList.remove('hidden');
        listBody.innerHTML = filtered.map((b, idx) => buildBookRowHtml(b, idx + 1)).join('');
      }
    }

