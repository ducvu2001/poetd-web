    async function imageSrcToBase64(src) {
      if (src.startsWith('data:image/')) {
        const commaIdx = src.indexOf(',');
        const mimeMatch = src.match(/^data:(image\/[a-zA-Z0-9+.-]+);base64,/);
        return {
          mimeType: mimeMatch ? mimeMatch[1] : 'image/jpeg',
          data: src.slice(commaIdx + 1)
        };
      }
      const res = await fetch(src);
      const blob = await res.blob();
      return await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onloadend = () => {
          const dataUrl = reader.result;
          const commaIdx = dataUrl.indexOf(',');
          resolve({
            mimeType: blob.type || 'image/jpeg',
            data: dataUrl.slice(commaIdx + 1)
          });
        };
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    }

    async function scanWishImageWithAI(isAuto = false) {
      const imgSrc = document.getElementById('wish-image').value.trim();
      const statusEl = document.getElementById('img-fetch-status');
      const btn = document.getElementById('btn-ai-scan-wish');

      if (!imgSrc) {
        if (!isAuto) showToast('Bạn hãy tải ảnh bill / sản phẩm lên hoặc dán Ctrl+V trước nhé!', 'error');
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.classList.add('opacity-60');
      }
      statusEl.textContent = '📸 AI đang đọc bill / sản phẩm...';

      try {
        const inlineImg = await imageSrcToBase64(imgSrc);
        const apiKey = "";
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

        const promptText = `Hãy phân tích hình ảnh này (có thể là ảnh chụp màn hình sản phẩm Mercari/Shopee/web, ảnh bill mua hàng, hoặc ảnh chuyển khoản ngân hàng).
Hãy trích xuất thông tin và trả về JSON chuẩn:
- name: Tên món đồ / sản phẩm ngắn gọn, rõ ràng bằng tiếng Việt (nếu là bill chuyển khoản thì ghi nội dung chuyển khoản hoặc tên hàng).
- price: Giá tiền gốc ghi trên ảnh (chỉ trả số, ví dụ 450000 nếu là VNĐ, hoặc 2500 nếu là Yên Nhật ¥ / Won Hàn ₩ / Nhân dân tệ / USD). Nếu không thấy giá thì trả 0.
- currency: Mã tiền tệ của giá gốc trên ảnh, chọn 1 trong: "VND", "JPY", "KRW", "CNY", "USD", "THB".
- category: Chọn 1 trong các danh mục phù hợp nhất trong danh sách: ${JSON.stringify(customCategories)}.
- carrier: Nếu trong ảnh có đơn vị vận chuyển (SPX, GHTK, GHN, J&T, Viettel Post...) thì ghi tên viết tắt, không có thì để chuỗi rỗng "".
- tracking: Nếu trong ảnh có mã vận đơn (ví dụ SPXVN...) thì trích xuất chính xác, không có thì để chuỗi rỗng "".
- note: Ghi chú hữu ích rút ra từ ảnh (ví dụ: số tài khoản/người nhận bill, tình trạng hàng...).`;

        const payload = {
          contents: [{
            role: 'user',
            parts: [
              { text: promptText },
              {
                inlineData: {
                  mimeType: inlineImg.mimeType,
                  data: inlineImg.data
                }
              }
            ]
          }],
          generationConfig: {
            responseMimeType: "application/json",
            responseSchema: {
              type: "OBJECT",
              properties: {
                name: { type: "STRING" },
                price: { type: "NUMBER" },
                currency: { type: "STRING" },
                category: { type: "STRING" },
                carrier: { type: "STRING" },
                tracking: { type: "STRING" },
                note: { type: "STRING" }
              },
              required: ["name", "price", "currency", "category", "carrier", "tracking", "note"]
            }
          }
        };

        let result = null;
        for (let attempt = 0; attempt < 3; attempt++) {
          try {
            const response = await fetch(apiUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            if (!response.ok) throw new Error('HTTP ' + response.status);
            result = await response.json();
            break;
          } catch (err) {
            if (attempt === 2) throw err;
            await new Promise(r => setTimeout(r, 1000 * Math.pow(2, attempt)));
          }
        }

        const rawText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!rawText) throw new Error('Empty response');
        const info = JSON.parse(rawText);

        if (info.name) document.getElementById('wish-name').value = info.name;
        const detectedCur = ['VND', 'JPY', 'KRW', 'CNY', 'USD', 'THB'].includes(info.currency) ? info.currency : 'VND';
        document.getElementById('wish-currency').value = detectedCur;
        if (info.price && Number(info.price) > 0) {
          document.getElementById('wish-price').value = detectedCur === 'VND' ? Math.round(Number(info.price)) : Number(info.price);
        }
        updateCurrencyPreview('wish');
        if (info.category && customCategories.includes(info.category)) {
          document.getElementById('wish-category').value = info.category;
        }
        if (info.carrier) document.getElementById('wish-carrier').value = info.carrier;
        if (info.tracking) document.getElementById('wish-tracking').value = info.tracking.toUpperCase();
        if (info.note) {
          const existingNote = document.getElementById('wish-note').value.trim();
          document.getElementById('wish-note').value = existingNote ? `${existingNote} | ${info.note}` : info.note;
        }

        statusEl.textContent = '✅ AI đã trích xuất thông tin từ ảnh!';
        showToast('📸 AI đã đọc xong thông tin từ ảnh bill/sản phẩm!');
      } catch (err) {
        statusEl.textContent = '⚠️ Không đọc được chữ từ ảnh này';
        if (!isAuto) showToast('Không thể đọc ảnh này (có thể do link ảnh chặn truy cập chéo, hãy thử tải ảnh lên từ máy nhé!)', 'error');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.classList.remove('opacity-60');
        }
      }
    }

