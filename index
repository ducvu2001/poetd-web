              </div>

              <!-- 3-Step Interactive Status Bar -->
              <div class="grid grid-cols-3 gap-1 p-1 rounded-xl bg-brand-surfaceAlt/80 border border-brand-border/60">
                ${steps.map(st => {
                  const isActive = o.status === st;
                  return `
                    <button type="button" onclick="updateOrderStatus('${o.id}', '${st}')" class="py-1.5 px-1 rounded-lg text-[10px] sm:text-[11px] font-bold transition truncate ${isActive ? 'bg-brand-primary text-white shadow-2xs' : 'text-slate-600 hover:bg-white/60'}">
