    function toggleThemeDropdown(e) {
      if (e) e.stopPropagation();
      const menu = document.getElementById('theme-dropdown-menu');
      const chev = document.getElementById('theme-dropdown-chevron');
      if (!menu) return;
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        if (chev) chev.classList.add('rotate-180');
      } else {
        menu.classList.add('hidden');
        if (chev) chev.classList.remove('rotate-180');
      }
    }

    function selectThemeFromDropdown(theme) {
      setTheme(theme);
      const menu = document.getElementById('theme-dropdown-menu');
      const chev = document.getElementById('theme-dropdown-chevron');
      if (menu) menu.classList.add('hidden');
      if (chev) chev.classList.remove('rotate-180');
    }

    window.addEventListener('click', (e) => {
      const wrap = document.getElementById('theme-dropdown-wrap');
      const menu = document.getElementById('theme-dropdown-menu');
      const chev = document.getElementById('theme-dropdown-chevron');
      if (wrap && menu && !wrap.contains(e.target)) {
        menu.classList.add('hidden');
        if (chev) chev.classList.remove('rotate-180');
      }
    });

    function setTheme(theme) {
      if (!THEME_META[theme]) theme = 'blackpink';
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem(THEME_KEY, theme);

      Object.keys(THEME_META).forEach(tKey => {
        const opt = document.getElementById(`theme-opt-${tKey}`);
        if (!opt) return;
        const check = opt.querySelector('.theme-check');
        if (tKey === theme) {
          opt.classList.add('bg-brand-primarySoft/60', 'text-brand-primaryText');
          if (check) check.classList.remove('hidden');
        } else {
          opt.classList.remove('bg-brand-primarySoft/60', 'text-brand-primaryText');
          if (check) check.classList.add('hidden');
        }
      });

      applyThemeAvatarsToDOM();
      updateDefaultThemeButtonUI();
    }

