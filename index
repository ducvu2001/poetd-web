              accent: { type: "STRING" },
              accentSoft: { type: "STRING" },
              headerBg: { type: "STRING" },
              headerText: { type: "STRING" },
              headerSub: { type: "STRING" }
            },
            required: ["themeName", "bgMain", "surfaceAlt", "border", "primary", "primarySoft", "accent", "accentSoft", "headerBg", "headerText", "headerSub"]
          }
        }
      };

      try {
        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!rawText) throw new Error('Empty');
        const c = JSON.parse(rawText);

        const vars = {
          '--ai-bg-main': c.bgMain,
          '--ai-surface-alt': c.surfaceAlt,
          '--ai-border': c.border,
          '--ai-primary': c.primary,
          '--ai-primary-hover': c.primary,
