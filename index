        origPrice: currency !== 'VND' ? origPrice : 0,
        price: vndPrice,
        status: rawTracking ? 'Đang về' : (document.getElementById('wish-status').value || 'Đang về'),
        link: rawLink,
        image: document.getElementById('wish-image').value.trim(),
        stars: Number(document.getElementById('wish-stars').value) || 5,
        note: document.getElementById('wish-note').value.trim(),
        carrier: rawCarrier,
        tracking: rawTracking,
        starred: existing ? !!existing.starred : false
      };

      if (id) {
        const idx = appData.wishlist.findIndex(w => w.id === id);
        if (idx !== -1) appData.wishlist[idx] = payload;
      } else {
        appData.wishlist.unshift(payload);
      }

      if (wishFilter !== 'ALL' && wishFilter !== payload.status) {
        setWishFilter('ALL');
      }

      closeModal('modal-wish');

      if (rawTracking) {
        const existingOrder = appData.orders.find(o => (o.tracking || '').toUpperCase() === rawTracking);
        if (existingOrder) {
          existingOrder.name = payload.name;
          existingOrder.category = payload.category;
          existingOrder.currency = payload.currency;
          existingOrder.origPrice = payload.origPrice;
          if (payload.price > 0) existingOrder.price = payload.price;
          if (payload.image) existingOrder.image = payload.image;
          existingOrder.stars = payload.stars;
          if (rawCarrier) existingOrder.carrier = rawCarrier;
          if (payload.link) existingOrder.link = payload.link;
          if (payload.note) existingOrder.note = payload.note;
        } else {
          appData.orders.unshift({
            id: 'ord_' + Date.now(),
            name: payload.name,
            category: payload.category,
            currency: payload.currency,
            origPrice: payload.origPrice,
            price: payload.price,
            image: payload.image,
            stars: payload.stars,
            carrier: rawCarrier || (rawTracking.startsWith('SPX') ? 'SPX' : ''),
            tracking: rawTracking,
            link: payload.link || '',
            status: 'Chưa về ⏳',
            note: payload.note || '',
            starred: payload.starred
          });
        }
        setOrderFilter('ALL');
        persistAndSync();
        switchTab('orders');
        showToast(`🚚 Đã thêm mã ${rawTracking} và chuyển sang Đơn hàng đang về!`);
        return;
