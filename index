      }
      if (statusEl) statusEl.textContent = '✨ AI đang pha bảng màu...';

      const apiKey = "";
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const prompt = `Hãy thiết kế một bảng màu giao diện web hài hòa, sang trọng, dễ đọc dựa trên cảm hứng: "${idea}".
