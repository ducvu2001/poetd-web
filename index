    async function generateBookRecommendations() {
      const tasteBox = document.getElementById('book-rec-taste-box');
      const listEl = document.getElementById('book-rec-list');
      const btn = document.getElementById('btn-refresh-book-rec');
      const customKeyword = (document.getElementById('book-rec-custom-filter')?.value || '').trim();

      if (btn) {
        btn.disabled = true;
        btn.classList.add('opacity-60');
      }

      tasteBox.innerHTML = '✨ <b>Gemini đang đọc kệ sách của bạn</b> để phân tích gu văn học và chọn 3 cuốn sách tiếp theo hợp gu nhất...';
      listEl.innerHTML = `
        <div class="p-6 text-center text-slate-400 text-xs animate-pulse">
          Đang tìm kiếm những cuốn sách chạm đúng cảm xúc của bạn... 📚
        </div>
      `;

      const bookSummary = appData.books.map(b =>
        `- "${b.title}" (${b.author || 'Không rõ tác giả'}, thể loại: ${b.genre || 'Chưa rõ'}, trạng thái: ${b.status}, xếp hạng: ${b.stars} sao, cảm nhận: "${b.review || ''}")`
      ).join('\n');

      const existingTitles = appData.books.map(b => b.title.toLowerCase());
      const excludedNote = lastRecommendedBooks.length
        ? `\nKhông gợi ý lại các cuốn đã gợi ý trước đó: ${lastRecommendedBooks.map(b => b.title).join(', ')}.`
        : '';
      const keywordNote = customKeyword
        ? `\nYÊU CẦU LỌC ƯU TIÊN TỪ NGƯỜI DÙNG: Hãy ưu tiên gợi ý các đầu sách liên quan đến từ khóa/chủ đề "${customKeyword}".`
        : '';

      const apiKey = "";
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const prompt = `Đây là danh sách kệ sách cá nhân của người dùng:\n${bookSummary}\n\nHãy phân tích ngắn gọn "gu đọc sách" của người dùng trong 2 câu tiếng Việt ấm áp, tinh tế.${keywordNote}\nSau đó gợi ý đúng 3 cuốn sách mới KHÔNG trùng với danh sách trên${excludedNote}.\nVới mỗi cuốn, trả về: title (tên tiếng Việt phổ biến), author (tác giả), genre (thể loại ngắn gọn), reason (lý do cụ thể vì sao hợp gu, khoảng 20-30 từ), và summary (tóm tắt 1 câu để lưu vào cột đánh giá nhanh).`;

      const payload = {
        contents: [{ parts: [{ text: prompt }] }],
        generationConfig: {
          responseMimeType: "application/json",
          responseSchema: {
            type: "OBJECT",
            properties: {
              tasteProfile: { type: "STRING" },
              recommendations: {
                type: "ARRAY",
                items: {
                  type: "OBJECT",
                  properties: {
                    title: { type: "STRING" },
                    author: { type: "STRING" },
                    genre: { type: "STRING" },
                    reason: { type: "STRING" },
                    summary: { type: "STRING" }
                  },
                  required: ["title", "author", "genre", "reason", "summary"]
                }
              }
            },
            required: ["tasteProfile", "recommendations"]
          }
        }
      };

      try {
        let result = null;
        for (let attempt = 0; attempt < 3; attempt++) {
          try {
            const response = await fetch(apiUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            if (!response.ok) throw new Error('HTTP ' + response.status);
            result = await response.json();
            break;
          } catch (err) {
            if (attempt === 2) throw err;
            await new Promise(r => setTimeout(r, 1000 * Math.pow(2, attempt)));
          }
        }

        const rawText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!rawText) throw new Error('Empty response');
        const data = JSON.parse(rawText);

        lastRecommendedBooks = (data.recommendations || []).filter(
          rec => !existingTitles.includes((rec.title || '').toLowerCase())
        );

        tasteBox.innerHTML = `<div class="font-bold text-brand-primaryText mb-1">💡 Gu đọc sách của bạn:</div><div>${escapeHtml(data.tasteProfile || '')}</div>`;

        listEl.innerHTML = lastRecommendedBooks.map((rec, idx) => `
          <div class="p-4 rounded-2xl bg-white border border-brand-border shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="space-y-1 min-w-0">
