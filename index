    function updateSyncBadge(state) {
      const badge = document.getElementById('sync-status-badge');
      const timeEl = document.getElementById('last-sync-time');
      if (!badge) return;
      if (state === 'syncing') {
        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-300 animate-ping"></span> Đang đồng bộ...`;
      } else if (state === 'connected') {
        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400"></span> Đã kết nối Google Sheet`;
        if (sheetConfig.lastSync && timeEl) timeEl.textContent = `Cập nhật: ${sheetConfig.lastSync}`;
      } else {
        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400"></span> Đã lưu trên máy`;
        if (timeEl) timeEl.textContent = '';
      }
    }

    async function pushToGoogleSheet(silent = false) {
      if (!sheetConfig.url) {
        if (!silent) showToast('Bạn chưa nhập URL Google Apps Script!', 'error');
        return;
      }
      updateSyncBadge('syncing');
      try {
        await fetch(sheetConfig.url, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(appData)
        });
        const now = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        sheetConfig.lastSync = now;
        localStorage.setItem(SHEET_CONFIG_KEY, JSON.stringify(sheetConfig));
        updateSyncBadge('connected');
        if (!silent) showToast('☁️ Đã lưu toàn bộ dữ liệu lên Google Sheet!');
      } catch (err) {
        updateSyncBadge('local');
        if (!silent) showToast('Lỗi khi gửi dữ liệu lên Sheet!', 'error');
      }
    }

    async function pullFromGoogleSheet() {
      if (!sheetConfig.url) {
        showToast('Bạn chưa nhập URL Google Apps Script!', 'error');
        return;
      }
      updateSyncBadge('syncing');
      try {
        const res = await fetch(sheetConfig.url);
        const json = await res.json();
        if (json.status === 'success' && json.data) {
          if (Array.isArray(json.data.orders) && json.data.orders.length) appData.orders = json.data.orders;
          if (Array.isArray(json.data.wishlist) && json.data.wishlist.length) appData.wishlist = json.data.wishlist;
          if (Array.isArray(json.data.books) && json.data.books.length) appData.books = json.data.books;
          saveLocalOnly();
          syncCategorySelects();
          renderAll();
          const now = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
          sheetConfig.lastSync = now;
          localStorage.setItem(SHEET_CONFIG_KEY, JSON.stringify(sheetConfig));
          updateSyncBadge('connected');
          showToast('⬇️ Đã tải dữ liệu mới nhất từ Google Sheet!');
        } else {
          throw new Error('Invalid response');
        }
      } catch (err) {
        updateSyncBadge('connected');
        showToast('Không thể đọc dữ liệu từ Sheet (kiểm tra lại quyền Web App: Anyone)!', 'error');
      }
    }

    function syncNowFromSheet() {
      pullFromGoogleSheet();
    }

    function copyAppsScript() {
      const code = document.getElementById('apps-script-code').textContent;
      copyText(code, 'Đã copy mã Google Apps Script!');
    }

    function exportJSON() {
      const blob = new Blob([JSON.stringify(appData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `thu-ngo-ngan-backup-${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Đã tải xuống file sao lưu JSON!');
    }

    function importJSON(event) {
      const file = event.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const parsed = JSON.parse(e.target.result);
          if (parsed.orders && parsed.wishlist && parsed.books) {
            appData = parsed;
            persistAndSync();
            showToast('Đã khôi phục dữ liệu từ file JSON!');
          } else {
            showToast('File JSON không đúng định dạng!', 'error');
          }
        } catch (err) {
          showToast('Lỗi đọc file JSON!', 'error');
        }
      };
      reader.readAsText(file);
    }

    // ==================== UTILITIES ====================
    function renderAll() {
      renderOrders();
      renderWishlist();
      renderBooks();
    }

    function openModal(id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.remove('hidden');
      el.classList.add('flex');
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.add('hidden');
      el.classList.remove('flex');
    }

    function formatVND(num) {
      const n = Number(num) || 0;
      return n.toLocaleString('vi-VN') + ' ₫';
    }

    function getCategoryEmoji(cat) {
      const map = {
        'Goods Idol': '🎤',
        'Card & Photo': '🃏',
        'Thời trang Idol': '👕',
        'Đồ chơi & Decor': '🧸',
        'Ẩm thực': '🍣',
        'Khác': '✨'
      };
      return map[cat] || '🛍️';
    }

    function getTrackingLookupUrl(carrier, code) {
      const c = (code || '').trim();
      if (!c) return '';
      const upCarrier = (carrier || '').toUpperCase();
      if (upCarrier.includes('SPX') || c.toUpperCase().startsWith('SPX')) {
        return `https://spx.vn/detail/${encodeURIComponent(c)}`;
      }
      if (upCarrier.includes('GHTK')) {
        return `https://i.ghtk.vn/${encodeURIComponent(c)}`;
      }
      if (upCarrier.includes('GHN')) {
        return `https://donhang.ghn.vn/?order_code=${encodeURIComponent(c)}`;
      }
      if (upCarrier.includes('J&T')) {
        return `https://jtexpress.vn/vi/tracking?type=track&billcode=${encodeURIComponent(c)}`;
      }
      if (upCarrier.includes('VIETTEL')) {
        return `https://viettelpost.com.vn/tra-cuu-hanh-trinh-don/`;
      }
      return `https://www.google.com/search?q=${encodeURIComponent(c + ' tra cứu vận đơn')}`;
    }

    function compressImageFile(file, maxWidth, quality, callback) {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          let w = img.width;
          let h = img.height;
          if (w > maxWidth) {
            h = Math.round((h * maxWidth) / w);
            w = maxWidth;
          }
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, w, h);
          callback(canvas.toDataURL('image/jpeg', quality));
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function copyText(text, successMsg = 'Đã sao chép!') {
      const helper = document.getElementById('clipboard-helper');
      if (!helper) return;
      helper.value = text;
      helper.select();
      helper.setSelectionRange(0, 99999);
      try {
        document.execCommand('copy');
        showToast(successMsg);
      } catch (err) {
        showToast('Không thể copy tự động!', 'error');
      }
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const el = document.createElement('div');
      const bg = type === 'error' ? 'bg-rose-600' : 'bg-slate-900';
      el.className = `${bg} text-white text-xs sm:text-sm font-semibold px-4 py-3 rounded-2xl shadow-xl flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0`;
      el.textContent = message;
      container.appendChild(el);
      requestAnimationFrame(() => {
        el.classList.remove('translate-y-2', 'opacity-0');
      });
      setTimeout(() => {
        el.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => el.remove(), 300);
      }, 2800);
    }

    function escapeHtml(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function escapeAttr(str) {
      return escapeHtml(str);
    }

    // ==================== INITIALIZATION ====================
    window.addEventListener('DOMContentLoaded', () => {
      loadUserPrefs();
      loadSavedAiTheme();
      loadThemeAvatars();
      const savedTheme = localStorage.getItem(DEFAULT_THEME_KEY) || localStorage.getItem(THEME_KEY) || 'blackpink';
      setTheme(savedTheme);

      const savedView = localStorage.getItem(VIEW_MODE_KEY);
      if (savedView === 'list') currentViewMode = 'list';

      loadLocalData();
      loadCategories();
      updateSheetButtonsUI();
      setupClipboardPasteForImage();
      setViewMode(currentViewMode);
      switchTab(userPrefs.defaultTab || 'orders');
    });
  </script>
