    function renderCustomCategoryList() {
      const listEl = document.getElementById('custom-categories-list');
      if (!listEl) return;
      listEl.innerHTML = customCategories.map((cat, idx) => `
        <div class="flex items-center justify-between p-2.5 rounded-xl bg-brand-surfaceAlt/60 border border-brand-border">
          <span class="text-sm font-semibold text-slate-800">${getCategoryEmoji(cat)} ${escapeHtml(cat)}</span>
          ${customCategories.length > 1
            ? `<button type="button" onclick="deleteCustomCategory(${idx})" class="px-2.5 py-1 rounded-lg hover:bg-rose-50 text-rose-500 text-xs font-bold">Xóa</button>`
            : ''
          }
        </div>
      `).join('');
    }

    function addCustomCategory() {
      const input = document.getElementById('new-category-input');
      const val = (input?.value || '').trim();
      if (!val) return;
      if (customCategories.some(c => c.toLowerCase() === val.toLowerCase())) {
        showToast('Danh mục này đã tồn tại rồi!', 'error');
        return;
      }
      customCategories.push(val);
      saveCategories();
      renderCustomCategoryList();
      if (input) input.value = '';
      showToast(`🏷️ Đã thêm danh mục "${val}"!`);
    }

    function deleteCustomCategory(idx) {
      if (customCategories.length <= 1) return;
      customCategories.splice(idx, 1);
      saveCategories();
      renderCustomCategoryList();
      showToast('Đã xóa danh mục!');
    }

