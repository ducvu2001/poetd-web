      const vndPrice = convertToVND(origPrice, currency);

      const payload = {
        id: id || 'w_' + Date.now(),
        name: rawName || (rawLink ? 'Món đồ từ link đã lưu' : 'Món đồ đã chốt đơn'),
        category: document.getElementById('wish-category').value || customCategories[0] || 'Goods Idol',
