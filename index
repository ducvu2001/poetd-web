    // ==================== PERSISTENCE & DATA LOADING ====================
    function loadLocalData() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          appData.orders = Array.isArray(parsed.orders) ? parsed.orders : JSON.parse(JSON.stringify(DEFAULT_ORDERS));
          appData.wishlist = Array.isArray(parsed.wishlist) ? parsed.wishlist : JSON.parse(JSON.stringify(DEFAULT_WISHLIST));
          appData.books = Array.isArray(parsed.books) ? parsed.books : JSON.parse(JSON.stringify(DEFAULT_BOOKS));
        } else {
          appData.orders = JSON.parse(JSON.stringify(DEFAULT_ORDERS));
          appData.wishlist = JSON.parse(JSON.stringify(DEFAULT_WISHLIST));
          appData.books = JSON.parse(JSON.stringify(DEFAULT_BOOKS));
          saveLocalOnly();
        }
      } catch (e) {
        appData.orders = JSON.parse(JSON.stringify(DEFAULT_ORDERS));
        appData.wishlist = JSON.parse(JSON.stringify(DEFAULT_WISHLIST));
        appData.books = JSON.parse(JSON.stringify(DEFAULT_BOOKS));
      }

      try {
        const cfgRaw = localStorage.getItem(SHEET_CONFIG_KEY);
        if (cfgRaw) sheetConfig = { ...sheetConfig, ...JSON.parse(cfgRaw) };
      } catch (e) {}
    }

    function saveLocalOnly() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
      } catch (e) {
        showToast('Bộ nhớ trình duyệt đã đầy (do ảnh quá nặng)!', 'error');
      }
    }

    function persistAndSync() {
      saveLocalOnly();
      renderAll();
      if (sheetConfig.url && sheetConfig.autoSync !== false) {
        pushToGoogleSheet(true);
      }
    }

    // ==================== CUSTOM CATEGORIES ====================
    function loadCategories() {
      try {
        const raw = localStorage.getItem(CATEGORIES_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) customCategories = parsed;
        }
      } catch (e) {}
      syncCategorySelects();
    }

    function saveCategories() {
      localStorage.setItem(CATEGORIES_KEY, JSON.stringify(customCategories));
      syncCategorySelects();
    }

    function syncCategorySelects() {
      const allCats = new Set(customCategories);
      appData.wishlist.forEach(w => { if (w.category) allCats.add(w.category); });
      appData.orders.forEach(o => { if (o.category) allCats.add(o.category); });
      customCategories = Array.from(allCats);

      const filterSel = document.getElementById('wish-cat-filter');
      if (filterSel) {
        const prev = filterSel.value;
        filterSel.innerHTML = `<option value="ALL">🏷️ Danh mục</option>` +
          customCategories.map(c => `<option value="${escapeAttr(c)}">${getCategoryEmoji(c)} ${escapeHtml(c)}</option>`).join('');
        if (prev && (prev === 'ALL' || customCategories.includes(prev))) filterSel.value = prev;
      }

      ['wish-category', 'order-category'].forEach(selId => {
        const sel = document.getElementById(selId);
        if (sel) {
          const prev = sel.value;
          sel.innerHTML = customCategories.map(c => `<option value="${escapeAttr(c)}">${getCategoryEmoji(c)} ${escapeHtml(c)}</option>`).join('');
          if (prev && customCategories.includes(prev)) sel.value = prev;
        }
      });
    }

