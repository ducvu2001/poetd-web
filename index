    writeSheetRows(ss, 'DonHangDangVe',
      ['id', 'name', 'category', 'price', 'currency', 'origPrice', 'carrier', 'tracking', 'link', 'status', 'stars', 'note', 'starred', 'image'],
      ['ID', 'Tên hàng', 'Danh mục', 'Giá (VNĐ)', 'Tiền tệ', 'Giá gốc', 'Đơn vị VC', 'Mã vận đơn', 'Link trao đổi', 'Trạng thái', 'Độ mê (sao)', 'Ghi chú', 'Ghim sao', 'Link ảnh'],
      payload.orders
    );
  }
  if (Array.isArray(payload.wishlist)) {
    writeSheetRows(ss, 'DoDaChotDon',
      ['id', 'name', 'category', 'price', 'currency', 'origPrice', 'status', 'link', 'stars', 'carrier', 'tracking', 'note', 'starred', 'image'],
      ['ID', 'Tên món đồ', 'Danh mục', 'Giá (VNĐ)', 'Tiền tệ', 'Giá gốc', 'Trạng thái', 'Link mua', 'Độ mê (sao)', 'Đơn vị VC', 'Mã vận đơn', 'Ghi chú', 'Ghim sao', 'Link ảnh'],
      payload.wishlist
    );
  }
  if (Array.isArray(payload.books)) {
    writeSheetRows(ss, 'KeSach',
      ['id', 'title', 'author', 'genre', 'status', 'stars', 'date', 'review', 'starred'],
      ['ID', 'Tên sách', 'Tác giả', 'Thể loại', 'Trạng thái', 'Xếp hạng (sao)', 'Năm hoàn thành', 'Đánh giá nhanh', 'Ghim sao'],
      payload.books
    );
  }

  return ContentService.createTextOutput(JSON.stringify({ status: 'success' }))
    .setMimeType(ContentService.MimeType.JSON);
}

function writeSheetRows(ss, sheetName, keys, headers, items) {
  var sheet = ss.getSheetByName(sheetName) || ss.insertSheet(sheetName);
  sheet.clearContents();
  var rows = [headers];
  items.forEach(function(item) {
    rows.push(keys.map(function(k) {
      var val = item[k];
      if (typeof val === 'string' && val.indexOf('data:image/') === 0) return '[Ảnh tải lên từ máy]';
      return val !== undefined && val !== null ? val : '';
    }));
  });
  sheet.getRange(1, 1, rows.length, headers.length).setValues(rows);
  sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold').setBackground('#FCE4EC');
  sheet.setFrozenRows(1);
}

function readSheetRows(ss, sheetName) {
  var sheet = ss.getSheetByName(sheetName);
  if (!sheet || sheet.getLastRow() &lt; 2) return [];
  var keyMap = {
    'DonHangDangVe': ['id', 'name', 'category', 'price', 'currency', 'origPrice', 'carrier', 'tracking', 'link', 'status', 'stars', 'note', 'starred', 'image'],
    'DoDaChotDon': ['id', 'name', 'category', 'price', 'currency', 'origPrice', 'status', 'link', 'stars', 'carrier', 'tracking', 'note', 'starred', 'image'],
    'KeSach': ['id', 'title', 'author', 'genre', 'status', 'stars', 'date', 'review', 'starred']
  };
  var keys = keyMap[sheetName] || [];
  var values = sheet.getRange(2, 1, sheet.getLastRow() - 1, keys.length).getValues();
  return values.map(function(row) {
    var obj = {};
    keys.forEach(function(k, i) {
      var v = row[i];
      if (k === 'starred') obj[k] = (v === true || v === 'TRUE' || v === 'true');
      else if (k === 'image' && v === '[Ảnh tải lên từ máy]') obj[k] = '';
      else obj[k] = v;
    });
    return obj;
  });
}</pre>
